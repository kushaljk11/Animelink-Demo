{
  "name": "rabies-track-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Rabies Track Nepal — Express + Prisma REST API (localhost:5000)",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:seed:accounts": "tsx prisma/seed-demo-accounts.ts",
    "db:clean": "tsx prisma/clean.ts",
    "db:demo": "tsx prisma/clean.ts --demo",
    "db:setup": "prisma generate && prisma migrate deploy && prisma db seed",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jose": "^6.2.16",
    "multer": "^2.0.2",
    "nepali-date-converter": "3.4.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "prisma": "6.19.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.0": true,
    "@prisma/engines@6.19.0": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.0": true
  }
}
