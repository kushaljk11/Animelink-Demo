# Local backend config. `npm run setup` copies this to backend/.env when missing.
# Do not use the localhost database URLs on Render.
DATABASE_URL="postgresql://animlink:kushal6612@localhost:5432/rabies_track"
DATABASE_URL_UNPOOLED="postgresql://animlink:kushal6612@localhost:5432/rabies_track"
# Any long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="dev-only-change-me-7f3c1a9e5b2d4f6a8c0e1b3d5f7a9c2e"
SESSION_TTL_HOURS=168
UPLOAD_DIR="./uploads"
UPLOAD_MAX_BYTES=5242880
REMINDER_DUE_SOON_DAYS=30
REMINDER_INTERVAL_MINUTES=60
PORT=5000
# Public link target for QR codes, certificates, and messages. Production defaults to Vercel.
FRONTEND_URL="http://localhost:3000"
# Extra browser origins, if needed. Localhost and the Vercel production domain are always allowed.
CORS_ORIGIN="http://localhost:3000"

# Render production environment variables (set in the Render dashboard, not in this file):
