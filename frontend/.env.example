# Frontend config. `npm run setup` (root) copies this to frontend/.env.local when missing.
# Browser-visible base URL of the Express API.
NEXT_PUBLIC_API_URL="http://localhost:5000/api"
# Optional: API URL used by server components if it differs (e.g. inside Docker).
# API_INTERNAL_URL="http://localhost:5000/api"
# Show the demo role switcher / demo logins in production builds.
NEXT_PUBLIC_ENABLE_ROLE_SWITCHER="false"
